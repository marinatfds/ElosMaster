PORT=8787
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://user:password@localhost:5432/elosmaster

JWT_SECRET=change-me-to-a-long-random-string

# Caminho para o arquivo JSON da Service Account do Google.
# A pasta com esse ID precisa ser compartilhada com o e-mail "client_email" do JSON da Service Account.
# Dentro dela, crie 3 subpastas chamadas exatamente "FGV", "PUC" e "Anual" com os documentos de cada uma.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=

# Só usado pelo script de migração (scripts/migrate-from-mssql.ts).
# Formato ADO.NET (é o que o driver "mssql" espera, não uma URL mssql://).
# Encrypt=false e TrustServerCertificate=true costumam ser necessários para um
# SQL Server local/on-premises sem certificado TLS configurado.
LEGACY_MSSQL_CONNECTION_STRING=Server=localhost;Database=ElosMaster;User Id=user;Password=password;Encrypt=false;TrustServerCertificate=true
